{
	"name": "@lokalise/node-api",
	"version": "17.0.0",
	"description": "Official Node.js SDK for Lokalise Expert and Vantage APIs",
	"license": "BSD-3-Clause",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lokalise/node-lokalise-api.git"
	},
	"keywords": [
		"lokalise",
		"localization",
		"translation",
		"i18n",
		"api",
		"sdk",
		"typescript",
		"nodejs",
		"vantage"
	],
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:fix:unsafe": "biome check --write --unsafe .",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"typecheck": "tsc -p tsconfig.test.json --noEmit"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.6",
		"@types/node": "^26.0.1",
		"@vitest/coverage-v8": "^5.0.1",
		"tsdown": "^0.23",
		"typescript": "7.1.0-beta",
		"undici": "^8.0.2",
		"vitest": "^5.0.1"
	},
	"bugs": {
		"url": "https://github.com/lokalise/node-lokalise-api/issues"
	},
	"homepage": "https://lokalise.github.io/node-lokalise-api",
	"exports": {
		".": {
			"types": "./dist/main.d.mts",
			"import": "./dist/main.mjs",
			"default": "./dist/main.mjs"
		}
	},
	"types": "./dist/main.d.mts",
	"directories": {
		"lib": "./src",
		"test": "./test"
	},
	"files": [
		"dist"
	],
	"author": "Lokalise group, Ilya Krukowski",
	"engines": {
		"node": ">=22.19.0"
	}
}
